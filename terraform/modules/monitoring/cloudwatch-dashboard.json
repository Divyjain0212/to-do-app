{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB Request Latency",
        "view": "timeSeries",
        "stacked": false,
        "region": "${aws_region}",
        "metrics": [
          ["AWS/ApplicationELB", "TargetResponseTime", "LoadBalancer", "${alb_arn_suffix}"]
        ],
        "period": 60,
        "stat": "Average"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ASG CPU Utilization",
        "view": "timeSeries",
        "stacked": false,
        "region": "${aws_region}",
        "metrics": [
          ["AWS/EC2", "CPUUtilization", "AutoScalingGroupName", "${asg_name}"]
        ],
        "period": 60,
        "stat": "Average"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB Unhealthy Hosts",
        "view": "timeSeries",
        "stacked": false,
        "region": "${aws_region}",
        "metrics": [
          ["AWS/ApplicationELB", "UnHealthyHostCount", "TargetGroup", "${target_group_arn_suffix}", "LoadBalancer", "${alb_arn_suffix}"]
        ],
        "period": 60,
        "stat": "Maximum"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "RDS DB Connections",
        "view": "timeSeries",
        "stacked": false,
        "region": "${aws_region}",
        "metrics": [
          ["AWS/RDS", "DatabaseConnections", "DBInstanceIdentifier", "${db_identifier}"]
        ],
        "period": 60,
        "stat": "Average"
      }
    }
  ]
}
