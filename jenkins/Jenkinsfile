pipeline {
  agent any

  environment {
    APP_DIR = 'app'
    IMAGE_NAME = 'todo-app'
    IMAGE_TAG = "${BUILD_NUMBER}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          sh '''
            cd ${APP_DIR}
            docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
          '''
        }
      }
    }

    stage('Login to Docker Hub') {
      steps {
        script {
          withCredentials([usernamePassword(credentialsId: 'dockerHubCred', usernameVariable: 'DOCKER_HUB_USER', passwordVariable: 'DOCKER_HUB_TOKEN')]) {
            sh '''
              echo "$DOCKER_HUB_TOKEN" | docker login -u "$DOCKER_HUB_USER" --password-stdin
            '''
          }
        }
      }
    }

    stage('Push to Docker Hub') {
      steps {
        script {
          withCredentials([usernamePassword(credentialsId: 'dockerHubCred', usernameVariable: 'DOCKER_HUB_USER', passwordVariable: 'DOCKER_HUB_TOKEN')]) {
            sh '''
              FULL_IMAGE_URI="$DOCKER_HUB_USER/${IMAGE_NAME}:${IMAGE_TAG}"

              docker tag ${IMAGE_NAME}:${IMAGE_TAG} "$FULL_IMAGE_URI"

              docker push "$FULL_IMAGE_URI"
              echo "Image pushed: $FULL_IMAGE_URI"
            '''
          }
        }
      }
    }

    stage('Rolling Deploy') {
      when {
        expression { return env.DEPLOY_STRATEGY == null || env.DEPLOY_STRATEGY == 'rolling' }
      }
      steps {
        script {
          echo 'Trigger rolling instance refresh via Terraform/ASG integration.'
          def deployCmd = '''
            set -eux
            FULL_IMAGE_URI="$DOCKER_HUB_USER/${IMAGE_NAME}:${IMAGE_TAG}"
            if [ -z "$FULL_IMAGE_URI" ]; then
              echo "docker_image_uri is empty; aborting deploy"
              exit 1
            fi
            echo "Deploying image: $FULL_IMAGE_URI"
            export AWS_DEFAULT_REGION=ap-south-1
            export AWS_REGION=ap-south-1
            if [ -z "$AWS_ACCESS_KEY_ID" ] || [ -z "$AWS_SECRET_ACCESS_KEY" ]; then
              echo "AWS credentials were not injected from awsCred"
              exit 1
            fi
            echo "AWS credentials injected from awsCred"
            if command -v terraform >/dev/null 2>&1; then
              echo "Using local terraform binary"
              cd terraform
              terraform init
              terraform validate
              terraform apply -auto-approve \
                -var="docker_image_uri=$FULL_IMAGE_URI" \
                -var-file=environments/development.tfvars
            else
              echo "Local terraform not found; using hashicorp/terraform Docker image"
              docker run --rm \
                -v "$PWD/terraform:/workspace" \
                -w /workspace \
                -e AWS_ACCESS_KEY_ID \
                -e AWS_SECRET_ACCESS_KEY \
                -e AWS_DEFAULT_REGION \
                -e AWS_REGION \
                hashicorp/terraform:1.6.6 init

              docker run --rm \
                -v "$PWD/terraform:/workspace" \
                -w /workspace \
                -e AWS_ACCESS_KEY_ID \
                -e AWS_SECRET_ACCESS_KEY \
                -e AWS_DEFAULT_REGION \
                -e AWS_REGION \
                hashicorp/terraform:1.6.6 validate

              docker run --rm \
                -v "$PWD/terraform:/workspace" \
                -w /workspace \
                -e AWS_ACCESS_KEY_ID \
                -e AWS_SECRET_ACCESS_KEY \
                -e AWS_DEFAULT_REGION \
                -e AWS_REGION \
                hashicorp/terraform:1.6.6 apply -auto-approve \
                -var="docker_image_uri=$FULL_IMAGE_URI" \
                -var-file=environments/development.tfvars
            fi
          '''

          withCredentials([
            usernamePassword(credentialsId: 'dockerHubCred', usernameVariable: 'DOCKER_HUB_USER', passwordVariable: 'DOCKER_HUB_TOKEN')
          ]) {
            try {
              echo 'Trying awsCred as AWS Credentials type'
              withCredentials([
                [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'awsCred', accessKeyVariable: 'AWS_ACCESS_KEY_ID', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
              ]) {
                sh deployCmd
              }
            } catch (ignored) {
              echo 'Falling back: trying awsCred as Username with password'
              withCredentials([
                usernamePassword(credentialsId: 'awsCred', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')
              ]) {
                sh deployCmd
              }
            }
          }
        }
      }
    }

    stage('Blue Green Deploy') {
      when {
        expression { return env.DEPLOY_STRATEGY == 'bluegreen' }
      }
      steps {
        echo 'Provision green capacity and shift ALB traffic after health checks.'
      }
    }
  }

  post {
    failure {
      echo 'Deployment failed. Trigger rollback routine and notify incident channel.'
    }
    success {
      echo 'Pipeline completed successfully.'
    }
  }
}