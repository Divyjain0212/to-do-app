@Library('Shared') _
pipeline {
  agent any

  environment {
    APP_DIR = 'app'
    IMAGE_NAME = 'todoapp'
    IMAGE_TAG = "latest"
    DOCKER_HUB_USER = 'divyj0212'
  }

  stages {
    stage('Build Docker Image') {
      steps {
        script {
          sh "cd ${APP_DIR}"
          docker_build("${IMAGE_NAME}","${IMAGE_TAG}","${DOCKER_HUB_USER}")
        }
      }
    }

    stage('Security Scan'){
      steps{
        script{
          sh "trivy image ${DOCKER_HUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}"
        }
      }
    }

    stage('Push Docker Image to Docker Hub'){
      steps{
        script{
          docker_push("${IMAGE_NAME}","latest","${DOCKER_HUB_USER}")
        }
      }
    }
  }
}

