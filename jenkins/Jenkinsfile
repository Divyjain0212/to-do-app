pipeline {
  agent any

  environment {
    APP_DIR = 'app'
    IMAGE_NAME = 'todo-app'
    IMAGE_TAG = "${BUILD_NUMBER}"
    CONFIG_S3_PREFIX = "runtime/build-${BUILD_NUMBER}"
    AWS_REGION = 'ap-south-1'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build & Push Docker Image') {
      steps {
        script {
          withCredentials([usernamePassword(credentialsId: 'dockerHubCred', usernameVariable: 'DOCKER_HUB_USER', passwordVariable: 'DOCKER_HUB_TOKEN')]) {
            sh '''
              cd ${APP_DIR}
              docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
              
              FULL_IMAGE_URI="$DOCKER_HUB_USER/${IMAGE_NAME}:${IMAGE_TAG}"
              echo "$DOCKER_HUB_TOKEN" | docker login -u "$DOCKER_HUB_USER" --password-stdin
              docker tag ${IMAGE_NAME}:${IMAGE_TAG} "$FULL_IMAGE_URI"
              docker push "$FULL_IMAGE_URI"
              echo "Image pushed: $FULL_IMAGE_URI"
            '''
          }
        }
      }
    }

    stage('Upload Config to S3') {
      steps {
        script {
          withCredentials([usernamePassword(credentialsId: 'awsCred', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
            sh '''
              set -e
              export AWS_DEFAULT_REGION=$AWS_REGION
              export PATH="$WORKSPACE/.bin:$HOME/.local/bin:$HOME/bin:/usr/local/bin:/usr/bin:/bin:/snap/bin:$PATH"
              hash -r

              TF_BIN="$(command -v terraform || true)"
              if [ -z "$TF_BIN" ]; then
                for CANDIDATE in /usr/local/bin/terraform /usr/bin/terraform /snap/bin/terraform; do
                  if [ -x "$CANDIDATE" ]; then
                    TF_BIN="$CANDIDATE"
                    break
                  fi
                done
              fi

              if [ -z "$TF_BIN" ]; then
                TF_VERSION="1.6.6"
                TF_DIR="${WORKSPACE}/.bin"
                TF_ZIP="terraform_${TF_VERSION}_linux_amd64.zip"
                TF_URL="https://releases.hashicorp.com/terraform/${TF_VERSION}/${TF_ZIP}"
                mkdir -p "$TF_DIR"

                echo "Terraform not found in PATH, downloading ${TF_VERSION} to workspace..."
                if command -v curl >/dev/null 2>&1; then
                  curl -fsSL "$TF_URL" -o "/tmp/${TF_ZIP}"
                elif command -v wget >/dev/null 2>&1; then
                  wget -q "$TF_URL" -O "/tmp/${TF_ZIP}"
                else
                  echo "ERROR: curl or wget is required to download Terraform"
                  exit 1
                fi

                if command -v unzip >/dev/null 2>&1; then
                  unzip -oq "/tmp/${TF_ZIP}" -d "$TF_DIR"
                elif command -v python3 >/dev/null 2>&1; then
                  TF_ZIP="$TF_ZIP" TF_DIR="$TF_DIR" python3 - <<'PY'
import os
import zipfile

zip_path = f"/tmp/{os.environ['TF_ZIP']}"
extract_to = os.environ['TF_DIR']
zipfile.ZipFile(zip_path).extractall(extract_to)
PY
                else
                  echo "ERROR: unzip or python3 is required to extract Terraform"
                  exit 1
                fi

                chmod +x "${TF_DIR}/terraform"
                TF_BIN="${TF_DIR}/terraform"
              fi

              echo "Using Terraform binary: $TF_BIN"
              "$TF_BIN" version

              AWS_BIN="$(command -v aws || true)"
              if [ -z "$AWS_BIN" ]; then
                for CANDIDATE in /usr/local/bin/aws /usr/bin/aws /snap/bin/aws /usr/local/aws-cli/v2/current/bin/aws; do
                  if [ -x "$CANDIDATE" ]; then
                    AWS_BIN="$CANDIDATE"
                    break
                  fi
                done
              fi

              if [ -z "$AWS_BIN" ]; then
                AWS_BIN_DIR="${WORKSPACE}/.bin"
                AWS_INSTALL_ROOT="${WORKSPACE}/.aws-cli"
                AWS_INSTALL_ZIP="awscliv2.zip"
                AWS_INSTALL_TMP="/tmp/awscliv2"
                mkdir -p "$AWS_BIN_DIR"
                rm -rf "$AWS_INSTALL_TMP"
                mkdir -p "$AWS_INSTALL_TMP"

                echo "AWS CLI not found in PATH, downloading AWS CLI v2 to workspace..."
                if command -v curl >/dev/null 2>&1; then
                  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "/tmp/${AWS_INSTALL_ZIP}"
                elif command -v wget >/dev/null 2>&1; then
                  wget -q "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -O "/tmp/${AWS_INSTALL_ZIP}"
                else
                  echo "ERROR: curl or wget is required to download AWS CLI"
                  exit 1
                fi

                if command -v unzip >/dev/null 2>&1; then
                  unzip -oq "/tmp/${AWS_INSTALL_ZIP}" -d "$AWS_INSTALL_TMP"
                elif command -v python3 >/dev/null 2>&1; then
                  AWS_INSTALL_ZIP="$AWS_INSTALL_ZIP" AWS_INSTALL_TMP="$AWS_INSTALL_TMP" python3 - <<'PY'
import os
import zipfile

zip_path = f"/tmp/{os.environ['AWS_INSTALL_ZIP']}"
extract_to = os.environ['AWS_INSTALL_TMP']
zipfile.ZipFile(zip_path).extractall(extract_to)
PY
                else
                  echo "ERROR: unzip or python3 is required to extract AWS CLI"
                  exit 1
                fi

                "$AWS_INSTALL_TMP/aws/install" -i "$AWS_INSTALL_ROOT" -b "$AWS_BIN_DIR" --update
                AWS_BIN="$AWS_BIN_DIR/aws"
              fi

              if [ -z "$AWS_BIN" ]; then
                echo "ERROR: aws cli is not available for the Jenkins runtime user"
                echo "PATH=$PATH"
                exit 1
              fi

              echo "Using AWS CLI binary: $AWS_BIN"
              "$AWS_BIN" --version

              cd terraform
              "$TF_BIN" init -reconfigure -input=false
              "$TF_BIN" apply -auto-approve -target=module.s3 -var-file=environments/development.tfvars
              CONFIG_BUCKET=$("$TF_BIN" output -raw assets_bucket_name)

              if [ -z "$CONFIG_BUCKET" ] || [ "$CONFIG_BUCKET" = "null" ]; then
                echo "ERROR: assets bucket output is empty"
                exit 1
              fi
              cd ..

              "$AWS_BIN" s3 cp app/.env "s3://${CONFIG_BUCKET}/${CONFIG_S3_PREFIX}/.env" || \
              "$AWS_BIN" s3 cp app/.env.example "s3://${CONFIG_BUCKET}/${CONFIG_S3_PREFIX}/.env"

              "$AWS_BIN" s3 cp ansible/playbooks/site.yml "s3://${CONFIG_BUCKET}/${CONFIG_S3_PREFIX}/site.yml"
            '''
          }
        }
      }
    }

    stage('Blue-green Deployment with Terraform') {
      steps {
        script {
          withCredentials([
            usernamePassword(credentialsId: 'dockerHubCred', usernameVariable: 'DOCKER_HUB_USER', passwordVariable: 'DOCKER_HUB_TOKEN'),
            usernamePassword(credentialsId: 'awsCred', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')
          ]) {
            sh '''
              set -e
              export AWS_DEFAULT_REGION=$AWS_REGION
              export PATH="$WORKSPACE/.bin:$HOME/.local/bin:$HOME/bin:/usr/local/bin:/usr/bin:/bin:/snap/bin:$PATH"
              hash -r

              TF_BIN="$(command -v terraform || true)"
              if [ -z "$TF_BIN" ]; then
                for CANDIDATE in /usr/local/bin/terraform /usr/bin/terraform /snap/bin/terraform; do
                  if [ -x "$CANDIDATE" ]; then
                    TF_BIN="$CANDIDATE"
                    break
                  fi
                done
              fi

              if [ -z "$TF_BIN" ]; then
                TF_VERSION="1.6.6"
                TF_DIR="${WORKSPACE}/.bin"
                TF_ZIP="terraform_${TF_VERSION}_linux_amd64.zip"
                TF_URL="https://releases.hashicorp.com/terraform/${TF_VERSION}/${TF_ZIP}"
                mkdir -p "$TF_DIR"

                echo "Terraform not found in PATH, downloading ${TF_VERSION} to workspace..."
                if command -v curl >/dev/null 2>&1; then
                  curl -fsSL "$TF_URL" -o "/tmp/${TF_ZIP}"
                elif command -v wget >/dev/null 2>&1; then
                  wget -q "$TF_URL" -O "/tmp/${TF_ZIP}"
                else
                  echo "ERROR: curl or wget is required to download Terraform"
                  exit 1
                fi

                if command -v unzip >/dev/null 2>&1; then
                  unzip -oq "/tmp/${TF_ZIP}" -d "$TF_DIR"
                elif command -v python3 >/dev/null 2>&1; then
                  TF_ZIP="$TF_ZIP" TF_DIR="$TF_DIR" python3 - <<'PY'
import os
import zipfile

zip_path = f"/tmp/{os.environ['TF_ZIP']}"
extract_to = os.environ['TF_DIR']
zipfile.ZipFile(zip_path).extractall(extract_to)
PY
                else
                  echo "ERROR: unzip or python3 is required to extract Terraform"
                  exit 1
                fi

                chmod +x "${TF_DIR}/terraform"
                TF_BIN="${TF_DIR}/terraform"
              fi

              echo "Using Terraform binary: $TF_BIN"
              "$TF_BIN" version

              AWS_BIN="$(command -v aws || true)"
              if [ -z "$AWS_BIN" ]; then
                for CANDIDATE in /usr/local/bin/aws /usr/bin/aws /snap/bin/aws /usr/local/aws-cli/v2/current/bin/aws; do
                  if [ -x "$CANDIDATE" ]; then
                    AWS_BIN="$CANDIDATE"
                    break
                  fi
                done
              fi

              if [ -z "$AWS_BIN" ]; then
                AWS_BIN_DIR="${WORKSPACE}/.bin"
                AWS_INSTALL_ROOT="${WORKSPACE}/.aws-cli"
                AWS_INSTALL_ZIP="awscliv2.zip"
                AWS_INSTALL_TMP="/tmp/awscliv2"
                mkdir -p "$AWS_BIN_DIR"
                rm -rf "$AWS_INSTALL_TMP"
                mkdir -p "$AWS_INSTALL_TMP"

                echo "AWS CLI not found in PATH, downloading AWS CLI v2 to workspace..."
                if command -v curl >/dev/null 2>&1; then
                  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "/tmp/${AWS_INSTALL_ZIP}"
                elif command -v wget >/dev/null 2>&1; then
                  wget -q "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -O "/tmp/${AWS_INSTALL_ZIP}"
                else
                  echo "ERROR: curl or wget is required to download AWS CLI"
                  exit 1
                fi

                if command -v unzip >/dev/null 2>&1; then
                  unzip -oq "/tmp/${AWS_INSTALL_ZIP}" -d "$AWS_INSTALL_TMP"
                elif command -v python3 >/dev/null 2>&1; then
                  AWS_INSTALL_ZIP="$AWS_INSTALL_ZIP" AWS_INSTALL_TMP="$AWS_INSTALL_TMP" python3 - <<'PY'
import os
import zipfile

zip_path = f"/tmp/{os.environ['AWS_INSTALL_ZIP']}"
extract_to = os.environ['AWS_INSTALL_TMP']
zipfile.ZipFile(zip_path).extractall(extract_to)
PY
                else
                  echo "ERROR: unzip or python3 is required to extract AWS CLI"
                  exit 1
                fi

                "$AWS_INSTALL_TMP/aws/install" -i "$AWS_INSTALL_ROOT" -b "$AWS_BIN_DIR" --update
                AWS_BIN="$AWS_BIN_DIR/aws"
              fi

              if [ -z "$AWS_BIN" ]; then
                echo "ERROR: aws cli is not available for the Jenkins runtime user"
                echo "PATH=$PATH"
                exit 1
              fi

              echo "Using AWS CLI binary: $AWS_BIN"
              "$AWS_BIN" --version

              FULL_IMAGE_URI="$DOCKER_HUB_USER/${IMAGE_NAME}:${IMAGE_TAG}"
              echo "Deploying image: $FULL_IMAGE_URI"
              
              cd terraform
              "$TF_BIN" init -reconfigure -input=false
              "$TF_BIN" validate
              
              # Get current active environment (blue or green)
              CURRENT_ENV=$("$TF_BIN" output -raw active_environment 2>/dev/null || echo "blue")
              if [ "$CURRENT_ENV" = "blue" ]; then
                DEPLOY_ENV="green"
              else
                DEPLOY_ENV="blue"
              fi
              
              echo "Current environment: $CURRENT_ENV"
              echo "Deploying to: $DEPLOY_ENV"
              
              # Deploy to new environment
              "$TF_BIN" apply -auto-approve \
                -var="docker_image_uri=$FULL_IMAGE_URI" \
                -var="config_s3_prefix=${CONFIG_S3_PREFIX}" \
                -var="active_environment=$DEPLOY_ENV" \
                -var-file=environments/development.tfvars
              
              # Get new environment details
              NEW_TARGET_GROUP=$("$TF_BIN" output -raw ${DEPLOY_ENV}_target_group_arn 2>/dev/null || echo "")
              
              if [ -z "$NEW_TARGET_GROUP" ]; then
                echo "ERROR: Could not retrieve target group for $DEPLOY_ENV environment"
                exit 1
              fi
              
              echo "Waiting for instances to be healthy..."
              sleep 30
              
              # Switch ALB listener to new environment
              ALB_LISTENER_ARN=$("$TF_BIN" output -raw alb_listener_arn 2>/dev/null || echo "")
              
              if [ -z "$ALB_LISTENER_ARN" ]; then
                echo "ERROR: Could not retrieve ALB listener ARN"
                exit 1
              fi
              
              "$AWS_BIN" elbv2 modify-listener \
                --listener-arn "$ALB_LISTENER_ARN" \
                --default-actions Type=forward,TargetGroupArn="$NEW_TARGET_GROUP"
              
              echo "Blue-green deployment successful!"
              echo "Active environment switched to: $DEPLOY_ENV"
            '''
          }
        }
      }
    }
  }

  post {
    failure {
      echo 'Deployment failed'
    }
    success {
      echo 'Deployment successful'
    }
  }
}