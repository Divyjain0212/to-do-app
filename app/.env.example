# Copy this file to app/.env and adjust values as needed.
# For production/AWS RDS, configure DB_HOST, DB_USER, DB_PASSWORD, DB_NAME
# For local development, leave DB_* empty to use SQLite automatically

# AWS RDS / MySQL Configuration (Production)
# Uncomment and fill in these values to use MySQL:
# DB_HOST=your-rds-instance.xyz.us-east-1.rds.amazonaws.com
# DB_PORT=3306
# DB_NAME=tododb
# DB_USER=admin
# DB_PASSWORD=your-secure-password
# DATABASE_URL can override all above (takes precedence)

# Flask app runtime
PORT=8081
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-random-secret-key-in-production
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_TTL_HOURS=12

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8081/auth/google/callback

# MySQL Connection Pooling (only for MySQL backends)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

